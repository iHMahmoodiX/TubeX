{
  "name": "tubex",
  "description": "TubeX: a local-first, Persian/English YouTube creator workbench extension.",
  "private": true,
  "version": "0.5.1",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "build": "wxt build",
    "build:edge": "wxt build -b edge",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node tests/e2e/smoke.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "idb": "8.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@wxt-dev/module-react": "1.2.2",
    "fake-indexeddb": "6.2.6",
    "happy-dom": "21.0.3",
    "playwright-core": "1.56.1",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "4.1.12",
    "wxt": "0.21.4"
  }
}
